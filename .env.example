# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Inbox that should receive alerts.
# If FROM_EMAIL uses onboarding@resend.dev, this must be the email
# you used to sign up for Resend.
TO_EMAIL=you@example.com

# Optional. Defaults to Kompis Sverige Monitor <onboarding@resend.dev>
# Set this after you verify your own domain in Resend.
# FROM_EMAIL=Kompis Sverige Monitor <alerts@yourdomain.com>
